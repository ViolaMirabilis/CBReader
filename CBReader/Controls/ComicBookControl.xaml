<UserControl x:Class="CBReader.Controls.ComicBookControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CBReader.Controls"
             xmlns:converters="clr-namespace:CBReader.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="300">

    <!-- Handles the header of "add to favourites" or "remove form favourites" at runtime -->
    <UserControl.Resources>
        <converters:FavouriteVisibilityConverter x:Key="FavouriteVisibilityConverter"/>
        <converters:StatusEnumToStringConverter x:Key="StatusEnumToStringConverter"/>
    </UserControl.Resources>
    
    <!-- https://stackoverflow.com/questions/5020839/wpf-binding-with-placementtarget-and-relativesource -->
    <UserControl.ContextMenu>
        <ContextMenu Closed="ContextMenu_Closed">
            <MenuItem x:Name="FavouriteButton" Header="{Binding State.IsFavourite, Converter={StaticResource FavouriteVisibilityConverter}}"
                  Click="MenuItem_Click"/>
            <MenuItem x:Name="Rename" Header="Rename" Click="Rename_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    
    <!-- context menu for each comic book -->
    <Grid Height="200" Width="300" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition   Width="6*"/>
        </Grid.ColumnDefinitions>
        
        

        <!-- layer 0, so the image is above everything else-->

        <Image Grid.Column="0"
           Height="128"
           Width="91"
           Source="{Binding CoverPath}"
           Margin="0"
           RenderOptions.BitmapScalingMode="HighQuality"
           RenderOptions.EdgeMode="Aliased">
            <Image.RenderTransform>
                <ScaleTransform x:Name="ImageScale"
                            ScaleX="1" ScaleY="1"
                            CenterX="45.5" CenterY="64"/>
            </Image.RenderTransform>
            <Image.Style>
                <Style TargetType="Image">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                     To="1.2"
                                                     Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                    To="1.2"
                                                    Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                    To="1.0"
                                                    Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                    To="1.0"
                                                    Duration="0:0:0.2"/>
                                    </Storyboard>

                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding ShortenedTitle, StringFormat=Title: {0}}"
                Margin="15,36,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="12"
                FontFamily="Arial"
                FontWeight="Regular"
                TextWrapping="Wrap"
                TextAlignment="Left">
            </TextBlock>

            <TextBox BorderThickness="0"
                    FontSize="12"
                    FontFamily="Arial"
                    FontWeight="Regular"
                    TextWrapping="Wrap"
                    TextAlignment="Left"
                     Focusable="False"
                     IsReadOnly="True"
                     Visibility="Collapsed"
                     >
                
            </TextBox>

            
            <TextBlock Text="{Binding State.LastReadPage, StringFormat=Last read page: {0}}"
                Margin="15,18,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="12"
                FontFamily="Arial"
                FontWeight="Regular"
                TextWrapping="WrapWithOverflow"
                TextAlignment="Center">
            </TextBlock>

            <TextBlock Text="{Binding State.Status,
                Converter={StaticResource StatusEnumToStringConverter},
                StringFormat=Status: {0}}"
                    Margin="15,18,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontFamily="Arial"
                    FontWeight="Regular"
                    TextWrapping="WrapWithOverflow"
                    TextAlignment="Center">
            </TextBlock>

            <Image x:Name="imgFavourite"
                Height="24"
                Width="24"
                Margin="15,18,0,0"
                Source="C:\Users\zajac\Desktop\CBReader\CBReader\Assets\star.png"
                RenderOptions.BitmapScalingMode="HighQuality"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Visibility="{Binding State.IsFavourite, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        


    </Grid>

</UserControl>
