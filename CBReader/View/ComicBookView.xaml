<Window x:Class="CBReader.View.ComicBookView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CBReader.View"
        xmlns:converters="clr-namespace:CBReader.Converters"
        mc:Ignorable="d"
        Icon="/Assets/logo_ico.ico"
        Title="CBReader Viewer"
        Height="{Binding Source={x:Static SystemParameters.PrimaryScreenHeight}, Converter={converters:ScreenResolutionConverter}, ConverterParameter='0.75'}"
        Width="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}, Converter={converters:ScreenResolutionConverter}, ConverterParameter='0.78'}"
        MouseMove="Window_MouseMove"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.InputBindings>
        <KeyBinding Key="Right" Command="{Binding NextPageCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PreviousPageCommand}"/>
    </Window.InputBindings>
        
    <Grid  x:Name="ContentGrid">
        <TextBlock Grid.Row="0" Text="{Binding CurrentZoom}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Top"/>

        <TextBlock Grid.Row="0" Text="{Binding CurrentPage}" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <ScrollViewer x:Name="ComicBookScrollViewer" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          VerticalAlignment="Center" HorizontalAlignment="Center" VerticalScrollBarVisibility="Hidden">
                <!-- Gotta make a separate "two page view-->
            
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding CurrentZoom}" ScaleY="{Binding CurrentZoom}"/>
                </Grid.LayoutTransform>

                <StackPanel x:Name="ComicPageView"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Image x:Name="imgSingle"
                        Source="{Binding CurrentPageView}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Height="auto"
                        Width="auto"
                        Stretch="None">
                    </Image>
                    
                    <Image x:Name="imgDouble"
                        Source="{Binding NextPageView}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Height="auto"
                        Width="auto"
                        Stretch="None"
                        Visibility="{Binding IsDoublePage, Converter={StaticResource BoolToVis}}">

                    </Image>
                </StackPanel>
                
            </Grid>
            
        </ScrollViewer>
            

        <!-- Buttons that overlap the comic book -->
        <Grid x:Name="OverlapGUIGrid">
            <Slider Minimum="{Binding MaxZoomOut}"
                    Maximum="{Binding MaxZoomIn}"
                    Value="{Binding CurrentZoom, Mode=TwoWay}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="False"
                    Orientation="Vertical"
                    Height="200"
                    Width="50"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center">
            </Slider>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Button Content="1x Page View" Height="50" Width="100" Margin="5"
                        Command="{Binding OnePageViewCommand}"/>
                <Button x:Name="btnDoublePage" Content="2x Page View" Height="50" Width="100" Margin="5"
                        Command="{Binding TwoPageViewCommand}"/>
            </StackPanel>
            
        </Grid>
        
    </Grid>
</Window>
